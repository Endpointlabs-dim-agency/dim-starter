# Injected automatically by EndpointLabs when this project's database is
# provisioned (on demand — many apps never need one). Do not fill by hand
# in hosted projects; for local dev copy to .env.local.

# Always present once a database exists (any provider):
DATABASE_URL=
DIRECT_URL=

# Present when the project was provisioned with Supabase:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Present when file storage is connected:
BLOB_READ_WRITE_TOKEN=
